# Copy this file to .env and uncomment only the settings you need.

# Unity evaluation
# Omit this when Unity_lic.ulf is stored in ./unity_license_data.
# LICENSE_PATH=C:/path/to/unity_license_data

# API keys
# Existing-patch evaluation does not need a model API key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=

# SWE-agent baseline defaults
# Uncomment a value only when overriding the published baseline configuration.
# SWE_MODEL=gpt-5.2
# SWE_MODEL_TEMPERATURE=0.4
# SWE_MODEL_MAX_INPUT_TOKENS=12000
# SWE_MODEL_MAX_OUTPUT_TOKENS=1500
# SWE_MODEL_PER_INSTANCE_CALL_LIMIT=25
# SWE_AGENT_MAX_REQUERIES=3
# SWE_AGENT_UNBOUNDED=1

# Optional harness overrides
# SWE_GAME_BENCH_BACKEND=docker
# SWE_GAME_BENCH_DATA=./benchmark
# SWE_GAME_BENCH_RUNS=./runs
# WORKDIR=
# UNITY_TIMEOUT_SEC=2400
